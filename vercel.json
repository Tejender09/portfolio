{
  "installCommand": "npm --prefix client install",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/resume/pdf",
      "destination": "/Tejender_Singh_Resume.pdf"
    },
    {
      "source": "/api/resume/docx",
      "destination": "/Tejender_Singh_Resume.docx"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
