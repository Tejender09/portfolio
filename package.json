{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "install-client": "npm --prefix client install",
    "install-server": "npm --prefix server install",
    "build": "npm --prefix client run build",
    "server": "npm --prefix server run start",
    "client": "npm --prefix client run dev",
    "dev": "npm run server"
  },
  "dependencies": {
    "mongoose": "^8.3.1"
  }
}
